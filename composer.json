{
  "name": "a.treschilov/tinkoff-invest-api-sdk",
  "description": "PHP SDK for Tinkoff invest API V2",
  "type": "library",
  "version": "v0.3.16",
  "license": "Apache-2.0",
  "keywords": ["php", "sdk", "tinkoff", "invest", "v2", "invest api", "t invest", "t bank"],
  "support": {
    "email": "a.treschilov@yandex.ru"
  },
  "authors": [
    {
      "name": "Aleksey Treschilov",
      "email": "a.treschilov@yandex.ru"
    }
  ],
  "autoload": {
    "psr-4": {
      "Tinkoff\\": "src/Library/Tinkoff",
      "GPBMetadata\\": "src/Library/GPBMetadata",
      "ATreschilov\\TinkoffInvestApiSdk\\": "src/"
    }
  },
  "require": {
    "php": "^8.3",
    "ext-grpc": "^1.66",
    "grpc/grpc": "^1.57.0",
    "google/protobuf": "^4.29.2",
    "google/common-protos": "^v4.8.3"
  },
  "autoload-dev": {
    "psr-4": {
      "ATreschilov\\TinkoffInvestApiSdk\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.11.2",
    "phpunit/phpunit": "^12.0"
  },
  "scripts": {
    "test": "phpunit",
    "phpcs": "phpcs --standard=PSR12 examples/ src/ tests/ --ignore=*/src/Library/* --exclude=PSR1.Files.SideEffects",
    "phpcbf": "phpcbf --standard=PSR12 examples/ src/ tests/ --ignore=*/src/Library/* --exclude=PSR1.Files.SideEffects"
  }
}
